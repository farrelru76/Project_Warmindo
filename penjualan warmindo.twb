    <dashboard name='Story 1' type='storyboard'>
      <style />
      <size maxheight='764' maxwidth='1016' minheight='764' minwidth='1016' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='97906' id='1' param='vert' removable='false' type-v2='layout-flow' w='98426' x='787' y='1047'>
            <zone h='4319' id='3' type-v2='title' w='98426' x='787' y='1047' />
            <zone h='13220' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98426' x='787' y='5366' />
            <zone h='80367' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98426' x='787' y='18586'>
              <flipboard active-id='2' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Analisis Penjualan' captured-sheet='Analisis Performa Produk' id='1' />
                  <story-point caption='Analisis Jumlah Penjualan Per Bulan' captured-sheet='Analisis Tren Per Bulan' id='2' />
                  <story-point caption='Analisis Jumlah Penjualan Per Hari' captured-sheet='Analisis Tren Per Hari' id='4' />
                  <story-point caption='Analisis Jenis Layanan Pesanan' captured-sheet='Analisis Jenis Layanan Pesanan' id='6' />
                  <story-point caption='Analisis Preferensi Pembayaran' captured-sheet='Analisis Preferensi Pembayaran' id='7' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='24476' hidden='true' id='6' story-point-id='1' type-v2='text' w='97343' x='1772' y='76178'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>Temuan:</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'> Menu seperti </run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' italic='true'>Indomie Rasa Soto Betawi</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>, </run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' italic='true'>Soto Banjar Limau Kuit</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>, dan </run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' italic='true'>Kari Ayam</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'> terbukti menjadi produk </run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' italic='true'>best-seller</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'> yang mendominasi pemasukan warung.</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>Solusi:</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'> Jadikan menu-menu juara ini sebagai daya tarik utama pada papan menu atau promosi digital. Sebaliknya, untuk menu yang penjualannya rendah, lakukan evaluasi apakah perlu di-</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' italic='true'>bundle</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'> dengan minuman (misalnya paket hemat mie + es teh) atau diganti dengan varian rasa lain yang lebih diminati pasar.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' h='42277' hidden='true' id='7' story-point-id='4' type-v2='text' w='43504' x='54331' y='24476'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>Temuan:</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'> Penjualan tertinggi terjadi pada awal pekan (Selasa dan Senin), sementara hari Kamis mencatatkan volume dan omzet terendah (hanya sekitar Rp990.000).</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>Solusi:</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'> Lakukan intervensi promosi spesifik di hari sepi (seperti program diskon atau </run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' italic='true'>bundling</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'> khusus hari Kamis) untuk meratakan arus kunjungan pelanggan dan mendongkrak omzet harian yang masih di bawah rata-rata.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='39660' hidden='true' id='8' story-point-id='6' type-v2='text' w='52559' x='44488' y='34162'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>Temuan:</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'> Pendapatan antara </run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' italic='true'>Dine-In</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'> (Rp4,87 juta) dan </run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' italic='true'>Delivery</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'> (Rp4,33 juta) berada di angka yang </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>hampir seimbang</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>. Ini menunjukkan bahwa warung memiliki dua sumber pendapatan yang sama kuatnya.</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>Solusi:</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'> Pertahankan kualitas rasa makanan saat dikemas untuk </run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' italic='true'>delivery</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>. Di sisi lain, tingkatkan kenyamanan area makan di tempat (</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' italic='true'>Dine-In</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>) dengan fasilitas tambahan (seperti colokan listrik atau Wi-Fi) agar pelanggan betah berlama-lama dan memesan menu tambahan (</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' italic='true'>upselling</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>).</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' h='37565' hidden='true' id='9' story-point-id='7' type-v2='text' w='51280' x='47343' y='39136'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>Temuan:</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'> Mayoritas pelanggan (sekitar </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>80,7%</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>) ternyata sudah beralih menggunakan pembayaran digital berbasis QRIS, sementara uang tunai (</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' italic='true'>CASH</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>) hanya menyumbang sekitar </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>19,3%</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>.</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>Solusi:</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'> Pemilik warung wajib memastikan kestabilan jaringan internet dan kelancaran kode QRIS. Selain itu, Anda bisa bekerja sama dengan penyedia layanan pembayaran untuk menghadirkan promo </run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' italic='true'>cashback</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'> guna menarik lebih banyak transaksi non-tunai yang lebih higienis dan praktis.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='42539' id='10' story-point-id='2' type-v2='text' w='34941' x='63681' y='23953'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'>Tren &amp; Korelasi:</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'> Omzet bulanan naik-turun seirama dengan jumlah transaksi. </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'>Puncak Tertinggi:</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'> Juli 2022 dengan omzet </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'>Rp1.446.000</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'> (152 transaksi). </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'>Titik Terendah:</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'> April 2022 anjlok ke </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'>Rp899.000</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'> (95 transaksi) akibat penyesuaian musiman (Ramadan). </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'>Insight &amp; Solusi:</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'> Perlu strategi promosi/bundling khusus saat musim sepi (Ramadan) serta penambahan stok dan kapasitas di bulan sibuk (Juli).</run>
          </formatted-text>
        </zone>
      </zones>
      <simple-id uuid='{361F5068-CBBE-4760-A418-390538A85BC2}' />
    </dashboard>
  </dashboards>
